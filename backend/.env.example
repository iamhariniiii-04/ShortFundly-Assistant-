# ShortFundly Voice Assistant Environment Configuration
# Copy this file to .env in the backend folder and fill in your API keys

# Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=True

# 1. Hugging Face Inference API
# Get your token from: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# 2. Google Gemini API (For live search grounding with Google Search)
# Get your token from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. OpenWeatherMap API
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
DEFAULT_WEATHER_CITY=Chennai

# 4. Offline Speech (sherpa-onnx)
# Directory where sherpa-onnx models are stored
SHERPA_MODELS_DIR=sherpa_models
