# ShortFundly Voice Assistant - Frontend Firebase Configuration
# Copy this file to .env.local in the root directory for your Firebase web credentials
# These public client credentials identify your Firebase project to Google Cloud.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend URL (defaults to http://localhost:5000 in dev)
VITE_BACKEND_URL=http://localhost:5000
