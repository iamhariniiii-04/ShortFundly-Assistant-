{
  "expo": {
    "name": "Assi",
    "slug": "assi-voice-assistant",
    "owner": "hackyhr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "assivoice",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bro.voiceassistant",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Assi to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow Assi to use the microphone."
      }
    },
    "android": {
      "package": "com.bro.voiceassistant",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CALL_PHONE",
        "SEND_SMS",
        "READ_PHONE_STATE",
        "READ_CONTACTS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "BODY_SENSORS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF2E2E",
          "sounds": []
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Assi to use the microphone.",
          "speechRecognitionPermission": "Allow Assi to use speech recognition.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1167cafe-d1e8-4988-a0c4-20e4b05e28a4"
      }
    }
  }
}
