{
  "name": "shortfundly-voice-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "ShortFundly Voice Assistant - Cross-platform AI Voice Assistant for Windows and Android",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "vite build && electron-builder",
    "cap:sync": "vite build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "mobile": "npm --prefix mobile start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:build:apk": "npm --prefix mobile run build:apk",
    "backend": "python backend/app.py"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/device": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor-community/text-to-speech": "^5.1.0",
    "firebase": "^11.4.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.shortfundly.voiceassistant",
    "productName": "ShortFundly Voice Assistant",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShortFundly Voice Assistant",
      "uninstallDisplayName": "ShortFundly Voice Assistant"
    }
  }
}
